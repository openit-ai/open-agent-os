[Unit]
Description=OAOS Outline
After=network-online.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=outline
Group=outline
WorkingDirectory=/opt/outline
EnvironmentFile=/etc/oaos/outline.env
ExecStartPre=/usr/bin/yarn db:migrate
ExecStart=/usr/bin/node /opt/outline/build/server/index.js
Restart=on-failure
RestartSec=10
TimeoutStartSec=360
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

#!/usr/bin/env bash
# Store one secret in the Hermes .env without echoing it. See bootstrap/lib/secret.sh.
set -Eeuo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
# shellcheck source=bootstrap/lib/common.sh
. "$repo_root/bootstrap/lib/common.sh"
# shellcheck source=bootstrap/lib/platform.sh
. "$repo_root/bootstrap/lib/platform.sh"
# shellcheck source=bootstrap/lib/secret.sh
. "$repo_root/bootstrap/lib/secret.sh"

usage() {
  cat <<'EOF'
Usage: bash bootstrap/bin/oaos-secret-set KEY
       printf '%s\n' "$VALUE" | bash bootstrap/bin/oaos-secret-set KEY

Reads the value from a hidden prompt (terminal) or stdin, never from arguments.
Writes KEY=value into ${HERMES_HOME:-~/.hermes}/.env atomically, owner-only.
Exit: 0 stored; 1 invalid key or value; 3 blocked (protection could not be verified).
EOF
}

(($# == 1)) || { usage >&2; exit 1; }
case $1 in --help|-h) usage; exit 0 ;; esac
[[ -n ${HOME:-} ]] || { printf 'HOME is not set.\n' >&2; exit 1; }
os_detect >/dev/null || exit 3
oaos_secret_set "$1"

# Secret template — DO NOT commit plaintext values. Fill with real values before apply.
# Production MUST provide secrets via external management (ExternalSecrets, SealedSecrets, Vault, or kubectl create secret).
# Generate base64: echo -n 'value' | base64 -w0
# Or use: kubectl create secret generic oaos-secrets --from-literal=... (preferred — avoids storing plaintext yaml)
apiVersion: v1
kind: Secret
metadata:
  name: oaos-secrets
  namespace: open-agent-os
type: Opaque
stringData:
  POSTGRES_PASSWORD: "CHANGE_ME_POSTGRES_PASSWORD"
  REDIS_PASSWORD: ""  # leave empty if no auth, or set
  JWT_SIGNING_KEY: "CHANGE_ME_32_BYTES_MIN_JWT"
  AUDIT_SIGNING_KEY: "CHANGE_ME_AUDIT_SIGNING_KEY_32B"
  OAOS_SIGNING_KEY: "CHANGE_ME_AUDIT_SIGNING_KEY_32B"  # defaults to AUDIT_SIGNING_KEY
  ADMIN_JWT_SECRET: "CHANGE_ME_ADMIN_JWT_32B_MIN"
  OAOS_ADMIN_BOOTSTRAP_PASSWORD: ""  # set only for initial bootstrap, then remove; never log
  OAOS_ADMIN_BOOTSTRAP_EMAIL: "admin@openit.co.kr"
  OAOS_ENCRYPTION_KEY: "CHANGE_ME_32_BYTE_BASE64_ENC_KEY=="
  AWS_ACCESS_KEY_ID: ""
  AWS_SECRET_ACCESS_KEY: ""
  # Optional: S3 bucket name can also be in secret if preferred
  # AWS_S3_BUCKET: "my-audit-bucket"
---

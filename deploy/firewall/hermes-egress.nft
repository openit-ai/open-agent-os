#!/usr/sbin/nft -f
# hermes-egress.nft — §16A.6 Network Isolation (nftables) — v1.5.1 Controlled Egress Proxy
# Default: DENY-all egress for uid `hermes`; ALLOW only explicit ACP/MCP/LLM Gateway/Package Mirror.
# Pattern: Hermes → Controlled Egress Proxy → (LLM Gateway | Approved Package Mirror)
# §16A.6 v1.5.1: Arbitrary Internet / Direct Public Registry is DENY by default.
#
# Load:   sudo nft -f /etc/nftables/hermes-egress.nft
#         (or copy to /etc/nftables/main.nft include)
# Check:  sudo nft list ruleset
# Flush:  sudo nft flush ruleset  (caution — flushes all)
#
# Design (v1.5.1 Controlled Egress Proxy):
#   Chains attached to inet filter OUTPUT.
#   Matches packets owned by uid "hermes" (dedicated OS account, §16A.4).
#   DENY set evaluated BEFORE ALLOW so internal can never be reached even on overlap.
#   Default for hermes egress: DROP (zero-bypass, Invariant E).
#   Loopback + DNS always allowed for name resolution.
#
#   ┌──────────────────────────────────────────────────────────┐
#   │ Hermes (uid hermes, /home/hermes)                       │
#   │        │                                                │
#   │        ▼                                                │
#   │  Controlled Egress Proxy  (v1.5.1 §16A.6)                │
#   │   ├─ LLM Gateway (LLM_GATEWAY_HOST)        ALLOW        │
#   │   ├─ Approved Package Mirror               ALLOW        │
#   │   │   (PACKAGE_MIRROR_HOST)                             │
#   │   └─ Explicit Domain Allowlist             ALLOW (opt)  │
#   │                                                         │
#   │   DENY:                                                 │
#   │   ├─ Internal DB / ERP / CRM / SSH / Admin  DENY       │
#   │   ├─ Arbitrary Internet destination         DENY       │
#   │   ├─ Direct Public Registry (pypi.org, npm, github) DENY│
#   │   └─ Public LLM API direct                DENY       │
#   └──────────────────────────────────────────────────────────┘
#
# CUSTOMIZE the variables below per deployment before loading.
# LLM_GATEWAY_HOST / PACKAGE_MIRROR_HOST are deployment-configurable
# (env LLM_GATEWAY_HOST / PACKAGE_MIRROR_HOST → rendered into this file
#  by deploy templating; do not hardcode public internet CIDRs as ALLOW).

# ---- Tunables (edit per customer environment) ----
define ACP_HOST            = 10.10.1.10
define ACP_PORT            = 8000
define MCP_HOST            = 10.10.1.11
define MCP_PORT            = 8001
# v1.5.1 Controlled Egress Proxy endpoints — configurable via env/template
# LLM_GATEWAY_HOST: Open Agent OS LLM Gateway (egress proxy for all LLM calls)
#   e.g. export LLM_GATEWAY_HOST=10.10.2.10  →  rendered as define below
define LLM_GATEWAY_HOST    = 10.10.2.10
define LLM_GATEWAY_PORT    = 443
# PACKAGE_MIRROR_HOST: Approved Package Mirror / Repository Proxy
#   e.g. export PACKAGE_MIRROR_HOST=10.10.2.20
define PACKAGE_MIRROR_HOST = 10.10.2.20
define PACKAGE_MIRROR_PORT = 443
# Optional: additional explicit domain allowlist (empty by default)
define ALLOWLIST_HOSTS     = { 10.10.2.10, 10.10.2.20 }

# Legacy CIDR sets (kept for backward compat / audit reference)
define LLM_HOSTS           = { 34.0.0.0/8, 34.120.0.0/13 }  # Example: GCP/Google AI — replace with real LLM Gateway CIDR
define UPDATE_HOSTS        = { 93.184.216.34 }             # Example placeholder — replace

# Internal networks that Hermes MUST NOT reach directly (§16A.6 DENY, Invariant E)
define INTERNAL_DB_NET   = 10.20.0.0/16
define ERP_NET           = 10.30.0.0/16
define CRM_NET           = 10.40.0.0/16
define INTERNAL_SSH_NET  = 10.0.0.0/8
define ADMIN_API_NET     = 10.50.0.0/16

# Public registries / direct internet — explicit DENY (§16A.6 v1.5.1)
# These are DENY-by-default (no ALLOW rule covers them). Listed here for audit
# and for optional explicit DROP before generic ALLOW, so that even if a
# permissive 443 ALLOW is accidentally added, registry direct still drops.
# Real enforcement for domain-based registries requires an HTTP CONNECT proxy
# with domain allowlist; nftables layer enforces IP/CIDR + default DROP.
# Example CIDRs below are placeholders — replace with resolved registry CIDRs
# or enforce via proxy allowlist (preferred).
define PYPI_NET           = { 151.101.0.0/16, 151.101.64.0/18 }   # pypi.org / files.pythonhosted.org (example)
define NPM_NET            = { 104.16.0.0/12 }                     # registry.npmjs.org (example, Cloudflare)
define GITHUB_NET         = { 140.82.112.0/20, 192.30.252.0/22 }  # github.com / raw.githubusercontent.com (example)
define PUBLIC_LLM_NET     = { 34.0.0.0/8 }                         # Direct public LLM (example GCP) — DENY, use LLM Gateway

flush ruleset

table inet hermes_egress {
  # Sets for maintainability (§16A.6 v1.5.1)
  set allowed_llm {
    type ipv4_addr
    flags interval
    elements = { $LLM_HOSTS }
  }
  set denied_registries {
    type ipv4_addr
    flags interval
    elements = { $PYPI_NET, $NPM_NET, $GITHUB_NET, $PUBLIC_LLM_NET }
  }

  chain output {
    type filter hook output priority 0; policy accept;

    # Only restrict packets originating from uid hermes.
    # All other users (root, openitsvc, etc.) are unaffected.

    # 1. Always allow loopback
    oifname "lo" meta skuid hermes accept

    # 2. DENY internal systems first (explicit, §16A.6 Invariant E)
    #    These drops take precedence over any ALLOW below.
    ip daddr $INTERNAL_DB_NET  meta skuid hermes drop
    ip daddr $ERP_NET          meta skuid hermes drop
    ip daddr $CRM_NET          meta skuid hermes drop
    ip daddr $ADMIN_API_NET    meta skuid hermes drop
    # SSH (port 22) to any internal net
    tcp dport 22 ip daddr $INTERNAL_SSH_NET meta skuid hermes drop
    # Common DB ports to anywhere (defense in depth — Hermes must go via MCP)
    tcp dport { 5432, 3306, 1433, 6379, 27017 } meta skuid hermes drop

    # 2b. DENY direct public registries & public LLM direct (§16A.6 v1.5.1)
    # Hermes → PyPI / npm / GitHub direct = DENY (must use Approved Package Mirror)
    # Hermes → Public LLM API direct       = DENY (must use LLM Gateway)
    ip daddr $PYPI_NET    meta skuid hermes drop
    ip daddr $NPM_NET     meta skuid hermes drop
    ip daddr $GITHUB_NET  meta skuid hermes drop
    # Public LLM direct DENY — only LLM_GATEWAY_HOST is ALLOWed below
    ip daddr $PUBLIC_LLM_NET meta skuid hermes drop
    # Generic registry set (covers all above if combined)
    ip daddr @denied_registries meta skuid hermes drop

    # 3. ALLOW: ACP / MCP (Execution Gateway) — §16A.6 minimal ALLOW
    ip daddr $ACP_HOST tcp dport $ACP_PORT meta skuid hermes accept
    ip daddr $MCP_HOST tcp dport $MCP_PORT meta skuid hermes accept

    # 4. ALLOW: Controlled Egress Proxy — LLM Gateway (§16A.6 v1.5.1)
    # Hermes → Public LLM direct DENY; Hermes → LLM Gateway ALLOW
    # Configurable via LLM_GATEWAY_HOST (env/template) — single egress point
    ip daddr $LLM_GATEWAY_HOST tcp dport $LLM_GATEWAY_PORT meta skuid hermes accept

    # 5. ALLOW: Controlled Egress Proxy — Approved Package Mirror (§16A.6 v1.5.1)
    # Hermes → PyPI/npm/GitHub direct DENY; Hermes → Approved Package Mirror ALLOW
    # Configurable via PACKAGE_MIRROR_HOST (env/template)
    ip daddr $PACKAGE_MIRROR_HOST tcp dport $PACKAGE_MIRROR_PORT meta skuid hermes accept

    # 6. ALLOW: DNS (needed to resolve ACP/MCP/LLM Gateway/Package Mirror hostnames)
    udp dport 53 meta skuid hermes accept
    tcp dport 53 meta skuid hermes accept

    # 7. ALLOW: NTP (optional, commented — uncomment if needed)
    # udp dport 123 meta skuid hermes accept

    # 8. DENY arbitrary internet for hermes — default DROP (§16A.6 v1.5.1)
    # No generic `tcp dport 443 accept` here. Only the explicit ALLOWs above
    # (ACP:8000, MCP:8001, LLM_GATEWAY_HOST:443, PACKAGE_MIRROR_HOST:443, DNS)
    # are permitted. All other egress from uid hermes drops.
    # Domain-based registries (pypi.org, npmjs.com, github direct) are
    # additionally denied above and require HTTP proxy allowlist enforcement
    # for full domain granularity (nftables is IP-layer; proxy is domain-layer).
    meta skuid hermes drop
  }

  chain input {
    type filter hook input priority 0; policy accept;
    # Ingress not restricted here; Hermes is a client. Add inbound rules if needed.
  }
}

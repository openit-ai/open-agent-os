[Unit]
Description=OAOS Adapter Mattermost — @agent DM/mention ingress to Control Plane (canonical; supersedes oaos-mm-bridge.service, kept 1 release)
Documentation=https://github.com/openit-ai/open-agent-os
After=network.target oaos-control-plane.service mattermost.service
Wants=oaos-control-plane.service

[Service]
Type=simple
User=oaos
Group=oaos
WorkingDirectory=/home/openit/apps/oaos/scripts
EnvironmentFile=-/etc/oaos/oaos.env
ExecStart=/usr/bin/python3 /home/openit/apps/oaos/scripts/oaos-mm-bridge.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/oaos/.hermes /var/lib/oaos/.open-agent-os/wiki-vault /tmp
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oaos-adapter-mattermost

[Install]
WantedBy=multi-user.target

[Unit]
Description=OAOS Control Plane — Mattermost Adapter Gateway :8100 (systemd production)
Documentation=https://github.com/openit-ai/open-agent-os
After=network.target network-online.target
Wants=network-online.target
# Optional dependencies — if postgres/redis are systemd services, uncomment:
# After=postgresql.service redis.service
# Requires=postgresql.service

[Service]
Type=simple
# --- Identity ---
# System install runs as dedicated user (recommended) or root.
# install-systemd.sh creates/uses user `oaos` if present, else `openitsvc`.
User=oaos
Group=oaos
# For user units: User/Group are omitted (managed by --user slice).
# WorkingDirectory is replaced at install time with the actual repo path.
WorkingDirectory=/home/openitsvc/open-agent-os/control-plane
EnvironmentFile=-/etc/oaos/oaos.env
# User-systemd deployments use the same canonical OAOS env file as the
# memory/index worker; secret values never belong in the unit.
EnvironmentFile=-%h/.config/oaos.env
Environment=OAOS_SESSION_BACKEND=redis
# PYTHONPATH: repo root + control-plane package dir (required for `control_plane.app`)
Environment=PYTHONPATH=/home/openitsvc/open-agent-os:/home/openitsvc/open-agent-os/control-plane
# Port is fixed at 8100 to match production (192.168.6.61 oaos-control-plane :8100)
# ExecStart uses the repo's Python. install-systemd.sh auto-detects:
#   /home/openitsvc/.hermes/hermes-agent/venv/bin/python > /usr/bin/python3.12 > /usr/bin/python3
ExecStart=/usr/bin/python3 -m uvicorn control_plane.app:app --host 127.0.0.1 --port 8100 --workers 1
# If OAOS_PYTHON is set in EnvironmentFile, override via wrapper (not needed for default):
# ExecStart=/bin/bash -c 'exec ${OAOS_PYTHON:-/usr/bin/python3} -m uvicorn control_plane.app:app --host 127.0.0.1 --port 8100 --workers 1'
Restart=always
RestartSec=5
TimeoutStopSec=30
# Graceful draining (§16D): SIGTERM → 30s drain, /readyz 503 while draining, /healthz stays 200
KillMode=mixed
KillSignal=SIGTERM

# --- Hardening (safe defaults; relax if repo needs write outside WorkingDirectory) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# Allow writes to repo WorkingDirectory and logs; adjust if repo lives elsewhere
ReadWritePaths=/home/openitsvc/open-agent-os
ReadOnlyPaths=/var/lib/oaos/.open-agent-os/wiki-vault
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
PrivateDevices=true
# Keep DevicePolicy open enough for network; tighten if desired:
# DevicePolicy=closed

# --- Logging ---
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oaos-control-plane

[Install]
WantedBy=multi-user.target

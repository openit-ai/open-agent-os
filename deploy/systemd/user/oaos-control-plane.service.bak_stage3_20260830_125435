[Unit]
Description=OAOS Control Plane (user) — Mattermost Adapter Gateway :8100
Documentation=https://github.com/openit-ai/open-agent-os
After=network.target
# Mirrors the active production unit on 192.168.6.61:
#   user unit at ~/.config/systemd/user/oaos-control-plane.service (WorkingDirectory control-plane, :8100)
# Use this file for `systemctl --user` installations.

[Service]
Type=simple
WorkingDirectory=%h/open-agent-os/control-plane
# Single canonical env file for the user-systemd distribution.
EnvironmentFile=-%h/open-agent-os/config/oaos.env
Environment=OAOS_SESSION_BACKEND=redis
Environment=PYTHONPATH=%h/open-agent-os:%h/open-agent-os/control-plane
ExecStart=%h/.hermes/hermes-agent/venv/bin/python -m uvicorn control_plane.app:app --host 127.0.0.1 --port 8100 --workers 1
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oaos-control-plane

[Install]
WantedBy=default.target

# --- Core ---
TENANT_ID=default
# v1.6: DB isolation — same instance may be shared with Mattermost/Outline but DBs/users are separate (mattermost / outline / openagentos); pgvector: pgvector/pgvector:pg16
DATABASE_URL=postgresql+asyncpg://openagentos:secret@localhost:5432/openagentos
REDIS_URL=redis://localhost:6379/0
JWT_SIGNING_KEY=change-me-32-bytes-min
AUDIT_SIGNING_KEY=change-me-audit-key

# --- Vault (choose one) ---
VAULT_BACKEND=encrypted_postgres  # or hashicorp_vault / aws_secrets
VAULT_ENCRYPTION_KEY=change-me-32-byte-base64==

# --- IAM ---
IAM_PROVIDER=google_workspace
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Hermes ---
HERMES_BASE_URL=http://localhost:8001
HERMES_SECURITY_DOMAINS=general,development,finance_hr,admin,high_risk_ephemeral

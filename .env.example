# --- Core ---
TENANT_ID=default
# v1.6: DB isolation — same instance may be shared with Mattermost/Outline but DBs/users are separate (mattermost / outline / openagentos); pgvector: pgvector/pgvector:pg16
DATABASE_URL=postgresql+asyncpg://openagentos:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/openagentos  # production: set via external secret, never commit plaintext
REDIS_URL=redis://localhost:6379/0
JWT_SIGNING_KEY=CHANGE_ME_32_BYTES_MIN_JWT  # 32+ chars, prod fail-closed — must override dev default
AUDIT_SIGNING_KEY=CHANGE_ME_AUDIT_SIGNING_KEY_32B  # 32+ chars, prod fail-closed
ADMIN_JWT_SECRET=CHANGE_ME_ADMIN_JWT_32B_MIN  # 32+ chars, prod fail-closed — admin-console JWT (dev default rejected in prod)
OAOS_ADMIN_BOOTSTRAP_PASSWORD=  # production initial L5 bootstrap — set once, never log/commit, then remove after first admin created
OAOS_ADMIN_BOOTSTRAP_EMAIL=admin@openit.co.kr
# Security hardening (v1.6.1)
OAOS_ENV=development  # production requires OAOS_ENV=production + DATABASE_URL + strong secrets (fail-closed)
OAOS_CORS_ORIGINS=http://localhost:3012,http://localhost:3000,http://localhost:8010,http://localhost:8100
OAOS_DATABASE_URL=  # optional override for admin-console; falls back to DATABASE_URL
# DB GRANT isolation (shared clusters): run docs/k8s-grant-isolation.sql as superuser:
#   REVOKE ALL ON DATABASE mattermost FROM openagentos; REVOKE ALL ON DATABASE outline FROM openagentos;


# --- Vault (choose one) ---
VAULT_BACKEND=encrypted_postgres  # or hashicorp_vault / aws_secrets
VAULT_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_ENC_KEY==  # 32+ chars, prod fail-closed

# --- IAM ---
IAM_PROVIDER=google_workspace
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Hermes ---
HERMES_BASE_URL=http://localhost:8001
HERMES_SECURITY_DOMAINS=general,development,finance_hr,admin,high_risk_ephemeral

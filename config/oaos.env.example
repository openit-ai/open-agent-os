# config/oaos.env.example — systemd production EnvironmentFile (unified)
# ------------------------------------------------------------------
# Purpose: single source of truth for ALL OAOS services when running
# under systemd (non-Docker). Docker deployments continue to use
# the repository root .env + deploy/docker-compose.*.yml (unchanged).
#
# Install:
#   cp config/oaos.env.example config/oaos.env        # repo-local (dev/systemd user)
#   # or system-wide:
#   sudo mkdir -p /etc/oaos
#   sudo cp config/oaos.env.example /etc/oaos/oaos.env
#   sudo chmod 600 /etc/oaos/oaos.env
#   sudo chown root:root /etc/oaos/oaos.env   # or openitsvc:openitsvc for user units
#   vi /etc/oaos/oaos.env   # replace EVERY CHANGE_ME_* value (never commit plaintext)
#
# Validation (no secret output):
#   bash scripts/check-production-config.sh --env-file /etc/oaos/oaos.env
#   bash deploy/systemd/check-production-config.sh   # wrapper
#
# Security:
# - Never commit the real file. Template contains only placeholders.
# - check-production-config.sh never prints secret values.
# - Production requires OAOS_ENV=production (§16D, §27); dev defaults are rejected.

# --- 0) Tenant & Environment (fail-closed) ------------------------
TENANT_ID=default
OAOS_ENV=production
# OAOS_ENV MUST be "production" for systemd production. Allowed aliases: production|prod (case-insensitive).
# Non-production values cause services to run in degraded dev mode and fail preflight in production.

# --- 1) Database & Redis (shared instance isolation) --------------
# DB isolation: same PostgreSQL instance may be shared with Mattermost/Outline
# but databases/users are separate (mattermost / outline / oaos).
# pgvector image: pgvector/pgvector:pg16 (see deploy/docker-compose.*.yml)
DATABASE_URL=postgresql+asyncpg://oaos:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/oaos
# Optional admin-console override; falls back to DATABASE_URL if empty:
OAOS_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
# If Redis requires auth: redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0

# --- 1a) Enterprise Outline Knowledge Index (read-only source) -----
# Sync reads documents and collection ACL through Outline; no Outline writes.
OUTLINE_API_URL=https://outline.example.com/api
OUTLINE_API_KEY=

OAOS_SESSION_BACKEND=redis
# Session state primary is Redis in production (H5 fail-closed, §14 v1.7.1). Must be 'redis' in production.
POSTGRES_DB=oaos
POSTGRES_USER=oaos
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# --- 2) Signing & Encryption (ALL must be 32+ chars, fail-closed) -
# Generate with: openssl rand -base64 32
JWT_SIGNING_KEY=CHANGE_ME_32_BYTES_MIN_JWT_SIGNING_KEY
AUDIT_SIGNING_KEY=CHANGE_ME_AUDIT_SIGNING_KEY_32B_MINIMUM
ADMIN_JWT_SECRET=CHANGE_ME_ADMIN_JWT_32B_MINIMUM
# Compatibility alias for security service:
OAOS_SIGNING_KEY=CHANGE_ME_32_BYTES_MIN_OAOS_SIGNING_KEY
# Vault encryption (Fernet AES+HMAC, sha256→b64 derive):
VAULT_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_ENC_KEY==
OAOS_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_ENC_KEY==
VAULT_BACKEND=encrypted_postgres

# --- 3) Admin bootstrap (set once, remove after first L5 created) -
OAOS_ADMIN_BOOTSTRAP_EMAIL=admin@openit.co.kr
OAOS_ADMIN_BOOTSTRAP_PASSWORD=
# Leave empty after bootstrap. Never log or commit. Production fails closed if L5 user missing.

# --- 4) CORS & Origins --------------------------------------------
OAOS_CORS_ORIGINS=http://localhost:3012,http://localhost:3000,http://localhost:8010,http://localhost:8100
# Production: replace localhost with your real origins, e.g.
# OAOS_CORS_ORIGINS=https://oaos.example.com,https://chat.example.com

# --- 4b) Personal Wiki Vault --------------------------------------
# Canonical owner-scoped attachment root. Raw files are stored by oaos,
# while LLM requests receive only bounded previews/extracted text.
OAOS_WIKI_VAULT=/var/lib/oaos/.open-agent-os/wiki-vault

# --- 5) Control Plane specific ------------------------------------
# Prefix OAOS_CP_* is read by control-plane/control_plane/config.py (env_prefix=OAOS_CP_)
# For systemd you can either use global keys above or OAOS_CP_* overrides.
# Example: OAOS_CP_DATABASE_URL=postgresql+asyncpg://oaos:CHANGE_ME@localhost:5432/oaos
#          OAOS_CP_REDIS_URL=redis://localhost:6379/0
#          OAOS_CP_HERMES_BASE_URL=http://localhost:8001
HERMES_BASE_URL=http://localhost:8001
HERMES_SECURITY_DOMAINS=general,development,finance_hr,admin,high_risk_ephemeral

# --- 6) Hermes Runtime (optional) ---------------------------------
# HERMES_API_KEY=   # if Hermes gateway requires auth

# --- 6b) Embeddings — Ollama bge-m3 (production: 127.0.0.1:11434) -----
# Production host has Ollama bge-m3:latest at 127.0.0.1:11434; memory service
# is on :8200 with PostgreSQL/pgvector. ChromaDB is forbidden.
OAOS_EMBED_API_URL=http://127.0.0.1:11434
OAOS_EMBED_MODEL=bge-m3:latest
# bge-m3 dimension is 1024; override only if you change model:
OAOS_EMBED_DIM=1024
# When OAOS_ENV=production, OAOS_EMBED_API_URL is required — service fails closed otherwise.

# --- 7) IAM / OAuth (user-scoped, OAOS-owned) --------------------
# The Control Plane owns the OAuth callback. Never copy Hermes token files
# into this host or grant the oaos service account access to /home/hermes.
IAM_PROVIDER=google_workspace
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:49697/callback
# Production OAuth state is Redis-primary and fails closed if unavailable.
OAOS_GOOGLE_OAUTH_STATE_TTL=600
OAOS_REDIS_URL=

# --- 8) Execution Gateway / Security (when run via systemd) -------
# No extra keys beyond sections 1-2, but keep for completeness:
# LOG_LEVEL=info
# AWS_S3_BUCKET=   # audit checkpoint (§31) — only if S3 external backup enabled

# --- 9) Systemd runtime hints -------------------------------------
# PYTHONPATH is set inside the unit files, not here. But if you run
# uvicorn manually, export:
#   PYTHONPATH=/home/openitsvc/open-agent-os:/home/openitsvc/open-agent-os/control-plane
# OAOS_PYTHON=/home/openitsvc/.hermes/hermes-agent/venv/bin/python  # custom interpreter (optional)
# PORT_OVERRIDES (only if you change defaults):
#   OAOS_CONTROL_PLANE_PORT=8100
#   OAOS_EXECUTION_GATEWAY_PORT=8001
#   OAOS_SECURITY_PORT=8002
#   OAOS_ADMIN_API_PORT=8010

# --- Notes --------------------------------------------------------
# - Validate before starting services:
#     bash scripts/check-production-config.sh --env-file /etc/oaos/oaos.env
# - Install units:
#     sudo bash deploy/systemd/install-systemd.sh --env-file /etc/oaos/oaos.env
#   or user units:
#     bash deploy/systemd/install-systemd.sh --user --env-file $HOME/open-agent-os/config/oaos.env
# - File permissions MUST be 600 (0600). install-systemd.sh enforces this.

"""Authorization Hook — Section 25, 7.2

PolicyEngine 호출 전 execution 차단 지점.

분기:
- Personal Delegation (Section 9): gmail/calendar/drive/tasks 동의 기반 — owner isolation + delegation 검증
- Enterprise Authorization (Section 11): 나머지 — PolicyEngine 평가 (Default Bundle + Group + JIT)

절대 규칙: Explicit Deny는 Personal Delegation을 override (Section 25)
"""
from __future__ import annotations

from dataclasses import dataclass
from typing import Any

try:
    from .normalize import parse_resource, is_personal_resource, normalize_resource, canonicalize_action
    from .connectors.google import GoogleConnector
    from .connectors.outline import OutlineConnector
except ImportError:
    from execution_gateway.normalize import parse_resource, is_personal_resource, normalize_resource, canonicalize_action  # type: ignore
    from execution_gateway.connectors.google import GoogleConnector  # type: ignore
    from execution_gateway.connectors.outline import OutlineConnector  # type: ignore

try:
    from policy_model.model import PolicyDecision, PolicyEvaluationRequest  # type: ignore
except Exception:
    PolicyDecision = None  # type: ignore
    PolicyEvaluationRequest = None  # type: ignore

try:
    from policy_engine.engine import PolicyEngine  # type: ignore
    from policy_engine.default_bundle import default_bundle  # type: ignore
except Exception:
    PolicyEngine = None  # type: ignore
    default_bundle = None  # type: ignore


@dataclass(frozen=True)
class AuthzResult:
    allowed: bool
    decision: str  # ALLOW / DENY / APPROVAL_REQUIRED
    reason: str
    source: str  # personal_delegation | enterprise_policy | explicit_deny 등
    trace_id: str | None = None
    matched_rule_id: str | None = None


class AuthorizationHook:
    """PolicyEngine 호출 전 execution 차단 — Personal vs Enterprise 분기

    사용법:
        hook = AuthorizationHook(policy_engine=..., google_connector=...)
        result = await hook.authorize(ctx, action="READ", resource="gmail/user/kim/*")
        if not result.allowed: deny
    """

    def __init__(
        self,
        policy_engine: Any | None = None,
        google_connector: GoogleConnector | None = None,
        outline_connector: OutlineConnector | None = None,
        tenant_id: str = "default",
    ):
        self.google = google_connector or GoogleConnector()
        self.outline = outline_connector or OutlineConnector()
        self.tenant_id = tenant_id
        # PolicyEngine이 없으면 default_bundle으로 초기화
        if policy_engine is not None:
            self.engine = policy_engine
        elif PolicyEngine is not None and default_bundle is not None:
            try:
                bundle = default_bundle(tenant_id)
                self.engine = PolicyEngine([bundle])
            except Exception:
                self.engine = None
        else:
            self.engine = None

    def _ctx_to_dict(self, ctx: Any) -> dict:
        if isinstance(ctx, dict):
            return ctx
        # Pydantic model
        if hasattr(ctx, "model_dump"):
            return ctx.model_dump()  # type: ignore
        if hasattr(ctx, "dict"):
            return ctx.dict()  # type: ignore
        return dict(ctx) if isinstance(ctx, dict) else {"user_id": getattr(ctx, "user_id", None), "tenant_id": getattr(ctx, "tenant_id", None), "agent_id": getattr(ctx, "agent_id", None), "trace_id": getattr(ctx, "trace_id", None), "session_id": getattr(ctx, "session_id", None), "delegation_id": getattr(ctx, "delegation_id", None), "credential_binding_id": getattr(ctx, "credential_binding_id", None)}

    async def authorize(
        self,
        agent_context: Any,
        action: str,
        resource: str,
        tool_name: str | None = None,
        extra_context: dict | None = None,
    ) -> AuthzResult:
        """권한 평가 — personal vs enterprise 분기 + PolicyEngine 호출.

        Returns:
            AuthzResult with decision
        """
        ctx = self._ctx_to_dict(agent_context)
        trace_id = ctx.get("trace_id")
        tenant_id = ctx.get("tenant_id") or self.tenant_id

        # 1. resource/action 정규화
        try:
            canon_resource = normalize_resource(resource)
        except ValueError as e:
            return AuthzResult(False, "DENY", f"invalid resource: {e}", "validation", trace_id)

        try:
            canon_action = canonicalize_action(action)
        except ValueError as e:
            return AuthzResult(False, "DENY", f"invalid action: {e}", "validation", trace_id)

        # 2. resource 파싱 — personal 여부로 분기 결정
        is_personal = is_personal_resource(canon_resource)

        # 3. Personal 분기 — owner isolation 우선
        if is_personal:
            owner_check = self.google.check_owner(ctx, canon_resource, tool_name)
            if not owner_check.allowed:
                return AuthzResult(
                    False, "DENY",
                    f"personal owner check failed: {owner_check.reason}",
                    "personal_delegation", trace_id,
                )
            # owner 검증 통과 → PolicyEngine에서도 Personal Delegation으로 평가
            # Explicit Deny가 있으면 DENY (PolicyEngine이 처리)

        else:
            # Enterprise / Shared — Outline ACL pre-check
            # outline 리소스면 ACL pre-check
            if canon_resource.startswith("outline"):
                acl_result = self.outline.check_acl(ctx, canon_resource, canon_action)
                if not acl_result.allowed:
                    return AuthzResult(False, "DENY", f"outline acl denied: {acl_result.reason}", "enterprise_policy", trace_id)

        # 4. PolicyEngine 평가 (있으면)
        if self.engine is not None and PolicyEvaluationRequest is not None:
            req = PolicyEvaluationRequest(
                tenant_id=tenant_id,
                user_id=ctx.get("user_id", ""),
                agent_id=ctx.get("agent_id", ""),
                action=canon_action,
                resource=canon_resource,
                context={
                    "delegation_id": ctx.get("delegation_id"),
                    "credential_binding_id": ctx.get("credential_binding_id"),
                    "tool": tool_name or "",
                    **(extra_context or {}),
                },
            )
            try:
                result = self.engine.evaluate(req)
                decision_str = result.decision.value if hasattr(result.decision, "value") else str(result.decision)
                source_str = result.source.value if hasattr(result.source, "value") else str(result.source)
                rule_id = result.matched_rule.id if result.matched_rule else None

                # personal SEARCH는 READ와 동등하게 허용 (Section 9: 개인 자원 조회)
                if decision_str == "DENY" and is_personal and canon_action == "SEARCH":
                    # 재시도: READ로 평가 (둘 다 조회 계열)
                    req_read = req.model_copy(update={"action": "READ"}) if hasattr(req, "model_copy") else PolicyEvaluationRequest(tenant_id=req.tenant_id, user_id=req.user_id, agent_id=req.agent_id, action="READ", resource=req.resource, context=req.context)
                    retry = self.engine.evaluate(req_read)
                    retry_decision = retry.decision.value if hasattr(retry.decision, "value") else str(retry.decision)
                    if retry_decision == "ALLOW":
                        retry_source = retry.source.value if hasattr(retry.source, "value") else str(retry.source)
                        retry_rule = retry.matched_rule.id if retry.matched_rule else None
                        return AuthzResult(True, "ALLOW", retry.reason, retry_source, trace_id, retry_rule)

                if decision_str == "ALLOW":
                    return AuthzResult(True, "ALLOW", result.reason, source_str, trace_id, rule_id)
                elif decision_str == "APPROVAL_REQUIRED":
                    return AuthzResult(False, "APPROVAL_REQUIRED", result.reason, source_str, trace_id, rule_id)
                else:  # DENY
                    return AuthzResult(False, "DENY", result.reason, source_str, trace_id, rule_id)
            except Exception as e:
                return AuthzResult(False, "DENY", f"policy engine error: {e}", "error", trace_id)
        else:
            # PolicyEngine unavailable — fail-closed in production, dev fallback only for tests
            import os as _os
            _is_prod = any(_os.getenv(k, "").strip().lower() in ("production", "prod") for k in ("OAOS_ENV", "ENV", "OAOS_ENVIRONMENT", "APP_ENV", "ENVIRONMENT"))
            if _is_prod:
                return AuthzResult(False, "DENY", "policy engine unavailable — fail-closed", "default_deny", trace_id)
            # Non-prod fallback — personal이면 ALLOW, enterprise는 DENY (안전) — test convenience only
            if is_personal:
                # owner check 통과했으므로 허용
                return AuthzResult(True, "ALLOW", "personal delegation (no policy engine)", "personal_delegation", trace_id)
            else:
                # Enterprise는 기본 DENY — JIT 승인이 필요할 수 있음
                # 테스트 편의를 위해 outline READ는 허용, 나머지는 APPROVAL_REQUIRED로 처리
                if canon_resource.startswith("outline") and canon_action in ("READ", "SEARCH"):
                    return AuthzResult(True, "ALLOW", "outline read allowed (fallback)", "default_bundle", trace_id)
                if canon_action in ("MERGE", "DEPLOY", "DELETE", "SEND", "PAY", "EXPORT", "SHARE", "ADMIN"):
                    return AuthzResult(False, "APPROVAL_REQUIRED", f"enterprise {canon_action} requires approval", "jit_approval", trace_id)
                return AuthzResult(False, "DENY", f"no policy engine — enterprise deny fallback for {canon_action} {canon_resource}", "default_deny", trace_id)

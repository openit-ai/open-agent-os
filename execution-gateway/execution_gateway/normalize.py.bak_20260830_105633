"""Resource / Action Normalization — Section 7.2, 19-20

- resource string → domain/scope/path 파싱
- action canonicalization (대소문자/동의어 정규화)
- MCP resource URI → canonical resource 변환
"""
from __future__ import annotations

import re
from dataclasses import dataclass

# ── Action canonicalization ──────────────────────────────────────────

# 동의어 → canonical Action 매핑 (Section 19)
_ACTION_ALIASES: dict[str, str] = {
    # read 계열
    "READ": "READ", "GET": "READ", "FETCH": "READ", "RETRIEVE": "READ", "SEARCH": "SEARCH",
    "QUERY": "SEARCH", "LIST": "SEARCH", "FIND": "SEARCH",
    # write 계열
    "CREATE": "CREATE", "INSERT": "CREATE", "ADD": "CREATE",
    "MODIFY": "MODIFY", "UPDATE": "MODIFY", "EDIT": "MODIFY", "PATCH": "MODIFY",
    "DELETE": "DELETE", "REMOVE": "DELETE", "TRASH": "DELETE",
    "EXECUTE": "EXECUTE", "RUN": "EXECUTE", "CALL": "EXECUTE",
    # domain actions
    "SEND": "SEND", "SEND_EMAIL": "SEND", "SEND_MAIL": "SEND",
    "MERGE": "MERGE", "DEPLOY": "DEPLOY", "PAY": "PAY",
    "EXPORT": "EXPORT", "DOWNLOAD": "EXPORT", "BULK_EXPORT": "EXPORT",
    "SHARE": "SHARE", "SHARE_EXTERNAL": "SHARE",
    "APPROVE": "APPROVE", "ADMIN": "ADMIN",
    # conversational / session ingress — low-risk Personal Agent interaction (small-business profile)
    # Added for Mattermost->ACP gate: ordinary chat is INTERACT, not a privileged write.
    "INTERACT": "INTERACT", "CHAT": "INTERACT", "SESSION_INTERACT": "INTERACT", "PROMPT": "INTERACT",
}

# 허용된 canonical actions (common-types Action enum과 일치)
ALLOWED_ACTIONS = frozenset(_ACTION_ALIASES.values())


def canonicalize_action(action: str) -> str:
    """action 문자열을 canonical 대문자 Action으로 정규화한다.

    Args:
        action: 원본 action 문자열 (예: 'send_email', 'Read', 'GET')
    Returns:
        canonical action (예: 'SEND', 'READ')
    Raises:
        ValueError: 알 수 없는 action인 경우
    """
    if not action or not action.strip():
        raise ValueError("action must be non-empty")
    key = action.strip().upper()
    # alias 직접 매칭
    if key in _ACTION_ALIASES:
        return _ACTION_ALIASES[key]
    # LLM이 보낼 수 있는 snake_case 대응
    if key.replace("-", "_") in _ACTION_ALIASES:
        return _ACTION_ALIASES[key.replace("-", "_")]
    raise ValueError(f"unknown action: {action!r} (allowed: {sorted(ALLOWED_ACTIONS)})")


# ── Resource normalization ────────────────────────────────────────────

_URI_SCHEME_RE = re.compile(r"^([a-zA-Z][a-zA-Z0-9+.\-]*):\/\/(.+)$")


@dataclass(frozen=True)
class ParsedResource:
    """정규화된 resource 파싱 결과"""
    raw: str                  # 원본 입력
    canonical: str            # 정규화된 canonical resource (domain/scope/path)
    domain: str               # 예: gmail, calendar, drive, github, outline, crm
    scope: str                # 예: user/kim, group/dev, organization
    path: str                 # 예: messages/123, calendar/events, pr/102
    is_personal: bool         # personal scope 여부 (user/*)
    is_wildcard: bool         # '*' 포함 여부


# personal domain 패턴 — 이 도메인들은 user scope를 사용
_PERSONAL_DOMAINS = frozenset({"gmail", "calendar", "drive", "tasks", "gmail_old"})
# enterprise / shared domains
_ENTERPRISE_DOMAINS = frozenset({"github", "crm", "erp", "outline", "notion", "slack", "mattermost", "production"})


def normalize_resource(resource: str) -> str:
    """resource 문자열을 canonical 'domain/scope/path' 형태로 정규화.

    지원 형식:
    - 'gmail/user/kim/messages/123' (이미 canonical)
    - 'gmail://user/kim/messages' (MCP URI scheme)
    - 'drive/user/kim/files' 등
    - 공백/슬래시 정리, 소문자 domain 유지
    """
    if not resource or not resource.strip():
        raise ValueError("resource must be non-empty")
    raw = resource.strip()
    # MCP URI scheme 처리: gmail://user/kim/... → gmail/user/kim/...
    m = _URI_SCHEME_RE.match(raw)
    if m:
        domain, rest = m.group(1).lower(), m.group(2).lstrip("/")
        canonical = f"{domain}/{rest}"
    else:
        # 이미 slash 형태 — 앞뒤 슬래시 제거, 중복 슬래시 정리
        canonical = re.sub(r"/{2,}", "/", raw.strip("/"))
        # domain은 소문자 정규화 (path는 대소문자 유지 — GitHub repo 등)
        parts = canonical.split("/", 1)
        if len(parts) == 2:
            canonical = f"{parts[0].lower()}/{parts[1]}"
        else:
            canonical = parts[0].lower()
    # 빈 세그먼트 제거 후 재조합
    # canonical에서 빈 세그먼트가 생기지 않도록 함
    return canonical


def parse_resource(resource: str) -> ParsedResource:
    """resource 문자열을 파싱하여 구조화된 정보를 반환.

    Returns:
        ParsedResource with domain, scope, path, is_personal 등
    Raises:
        ValueError: 파싱 불가 시
    """
    canonical = normalize_resource(resource)
    parts = canonical.split("/")
    if len(parts) < 1 or not parts[0]:
        raise ValueError(f"invalid resource: {resource!r}")

    domain = parts[0]

    # scope 결정: personal은 'user/{user}', 그 외는 다양한 scope
    # canonical 형태: domain/scope/... 또는 domain/path
    # scope 탐지 규칙:
    #   'user/{id}/...' → scope='user/{id}'
    #   'group/{id}/...' → scope='group/{id}'
    #   'organization/...' → scope='organization'
    #   그 외 1-segment resource는 scope=''로 처리
    scope = ""
    path = ""
    is_personal = False

    if len(parts) >= 3 and parts[1] in ("user", "group"):
        scope = f"{parts[1]}/{parts[2]}"
        path = "/".join(parts[3:]) if len(parts) > 3 else ""
        is_personal = parts[1] == "user"
    elif len(parts) >= 2 and parts[1] == "organization":
        scope = "organization"
        path = "/".join(parts[2:]) if len(parts) > 2 else ""
    elif len(parts) >= 2:
        # enterprise without explicit user/group — e.g. outline/team/docs
        # 첫 세그먼트 이후를 path로, scope는 빈 문자열
        scope = ""
        path = "/".join(parts[1:])
    else:
        path = ""

    return ParsedResource(
        raw=resource,
        canonical=canonical,
        domain=domain,
        scope=scope,
        path=path,
        is_personal=is_personal,
        is_wildcard="*" in canonical,
    )


def is_personal_resource(resource: str) -> bool:
    """해당 resource가 personal 자원인지 판별 (Section 8-9)."""
    try:
        parsed = parse_resource(resource)
        return parsed.is_personal and parsed.domain in _PERSONAL_DOMAINS
    except ValueError:
        return False


def is_enterprise_resource(resource: str) -> bool:
    """enterprise/shared 자원인지 판별."""
    try:
        parsed = parse_resource(resource)
        return not parsed.is_personal
    except ValueError:
        return False


def extract_owner_user_id(resource: str) -> str | None:
    """personal resource에서 owner user_id를 추출.

    예: gmail/user/kim/messages → employee:kim
    personal이 아니면 None 반환
    """
    try:
        parsed = parse_resource(resource)
        if parsed.is_personal and "/" in parsed.scope:
            _, user = parsed.scope.split("/", 1)
            return f"employee:{user}"
        return None
    except ValueError:
        return None
